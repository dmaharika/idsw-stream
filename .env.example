# Use signed Mux playback IDs (not asset IDs). The setup tool fills .env.local.
DAY_1_ID=
DAY_2_ID=

# Server-only values created by the Mux API setup tool.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_PLAYBACK_RESTRICTION_ID=

# Initially selected tab: 1 or 2. Missing/invalid values fall back to 1.
DEFAULT_DAY=1

# Full attendee access. Set APP_URL to the exact deployed origin in production.
APP_URL=http://localhost:3000
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_SECRET=
